<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF0EC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F8FAF7">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#18231D"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log in to see your mess diet plan"
            android:textSize="18sp"
            android:textColor="#59645D"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email or registration no."
            android:textStyle="bold"
            android:textColor="#18231D"/>

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="you@learner.manipal.edu"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:singleLine="true"
            android:background="@drawable/input_background"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:textColor="#18231D"/>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="Enter password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:singleLine="true"
            android:background="@drawable/input_background"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"/>


        <!-- Shown when the email / password is wrong. -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3261E"
            android:textSize="14sp"
            android:visibility="gone"
            android:paddingBottom="14dp"/>
        <!-- Checked against the local SQLite database. -->
        <androidx.appcompat.widget.AppCompatButton
        android:stateListAnimator="@null"
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Log in"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/primary_button"
            android:backgroundTint="@null"/>

        <!-- Opens the password-reset flow. -->
        <TextView
            android:id="@+id/forgotPasswordText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot password?"
            android:textColor="#207B52"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="18dp"/>

        <!-- Opens RegistrationActivity for new users. -->
        <androidx.appcompat.widget.AppCompatButton
        android:stateListAnimator="@null"
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Create account"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#207B52"
            android:background="@drawable/outline_button"
            android:backgroundTint="@null"/>


    </LinearLayout>
</ScrollView>
