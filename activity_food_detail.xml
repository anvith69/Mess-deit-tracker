<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <include layout="@layout/layout_header" />

        <!-- servings stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Servings"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
        android:stateListAnimator="@null"
                android:id="@+id/servingMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/outline_button"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/brand_green"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/servingsText"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
        android:stateListAnimator="@null"
                android:id="@+id/servingPlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/outline_button"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/brand_green"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- nutrition card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/detailCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/brand_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailProtein"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/text_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detailCarbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/text_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detailFat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/text_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detailFibre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/text_dark"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailGoalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log as"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/mealSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/spinner_background"
            android:padding="10dp" />

        <androidx.appcompat.widget.AppCompatButton
        android:stateListAnimator="@null"
            android:id="@+id/logButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/primary_button"
            android:backgroundTint="@null"
            android:text="Log this meal"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
